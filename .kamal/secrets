# Secrets defined here are available for reference under registry/password, env/secret,
# builder/secrets in config/deploy.yml. All secrets should be pulled from either password
# manager, ENV, or a file. DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.

# GitHub Container Registry personal access token with write:packages scope.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Rails master key used to decrypt config/credentials.yml.enc.
RAILS_MASTER_KEY=$(cat config/master.key)
